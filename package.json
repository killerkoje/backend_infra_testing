{
  "name": "backend-infra-testing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "migration:run": "npm run build && typeorm -d dist/database/data-source.js migration:run",
    "migration:revert": "npm run build && typeorm -d dist/database/data-source.js migration:revert",
    "migration:show": "npm run build && typeorm -d dist/database/data-source.js migration:show",
    "test:concurrency": "node scripts/concurrent-user-test.mjs",
    "test:concurrent-completion": "node scripts/concurrent-completion-test.mjs",
    "test:transaction-rollback": "npm run build && node scripts/verify-transaction-rollback.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/typeorm": "^12.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
